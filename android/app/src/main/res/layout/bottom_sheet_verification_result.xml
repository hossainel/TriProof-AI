<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
>
    <LinearLayout style="@style/Column">
        <TextView
            android:id="@+id/demoLabel"
            style="@style/Body"
            android:text="@string/demo_result"
            android:visibility="gone"
        />
        <TextView
            android:id="@+id/verdict"
            style="@style/Heading"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:accessibilityLiveRegion="assertive"
        />
        <TextView android:id="@+id/message" style="@style/Body" />
        <TextView android:id="@+id/serial" style="@style/Body" android:textIsSelectable="true" />
        <TextView android:id="@+id/details" style="@style/Body" android:textIsSelectable="true" />
        <TextView android:id="@+id/cloud" style="@style/Body" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/transfer"
            style="@style/Quiet"
            android:text="@string/transfer"
        />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Action"
            android:text="@string/close"
        />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
