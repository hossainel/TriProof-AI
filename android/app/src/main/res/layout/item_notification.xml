<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Line"
>
    <LinearLayout style="@style/Column">
        <TextView android:id="@+id/title" style="@style/Heading" />
        <TextView android:id="@+id/message" style="@style/Body" />
        <TextView android:id="@+id/time" style="@style/Body" />
        <TextView android:id="@+id/readState" style="@style/Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
