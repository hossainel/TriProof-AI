<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Column">
    <TextView style="@style/Heading" android:text="@string/demo" />
    <TextView style="@style/Body" android:text="@string/demo_info" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/genuine"
        style="@style/Action"
        android:text="@string/demo_genuine"
    />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/expired"
        style="@style/Quiet"
        android:text="@string/demo_expired"
    />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/forged"
        style="@style/Quiet"
        android:text="@string/demo_forged"
    />
</LinearLayout>
