APP_NAME="TriProof AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://t.focusautomobiles.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=triproof_ai
DB_USERNAME=triproof
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Cookie domain must be null on localhost/IPs. In production use the bare
# hostname without scheme or leading dot, e.g. t.focusautomobiles.com.
# NEVER use "${APP_NAME}" here (spaces are rejected by the cookie parser).
SESSION_DOMAIN=null
# Keep true behind HTTPS; set false only for plain-HTTP local development.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@triproof.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Ed25519 master signing keys (generate with: php artisan triproof:keys --write)
# HQ_PRIVATE_SIGNING_KEY never leaves the server.
# UNIVERSAL_PUBLIC_VERIFICATION_KEY is embedded in mobile clients.
# ---------------------------------------------------------------------------
HQ_PRIVATE_SIGNING_KEY=
UNIVERSAL_PUBLIC_VERIFICATION_KEY=fzJVLyOzjNkU5yO1nunqxJbizPggpPHek3Xctb654Pw=
KEY_ROTATION_MONTHS=6

# External Merkle anchoring and out-of-band clone/recall alerts
ANCHOR_PROVIDER=local_ledger
ALERT_WEBHOOK_URL=

# JWT API tokens (use a long random value; defaults to APP_KEY if omitted)
JWT_SECRET=
JWT_TTL_MINUTES=720
JWT_ISSUER=triproof-ai
JWT_AUDIENCE=triproof-mobile

# Offline blacklist package hard cap (bytes). Requirement: below 50 KB.
OFFLINE_BLACKLIST_MAX_BYTES=50000
OFFLINE_BLACKLIST_MAX_CLONED=5000
OFFLINE_BLOOM_TARGET_ENTRIES=30000
OFFLINE_BLOOM_MAX_BITS=240000

# Store Checkout Grace Rule
VERIFICATION_GRACE_SECONDS=300
VERIFICATION_GRACE_METERS=100

# Batch generation / PDF safety limits
MAX_BATCH_GENERATE=50000
MAX_PDF_UNITS=20000

# ---------------------------------------------------------------------------
# AI providers: "openai" for any OpenAI-compatible endpoint, "gemini", or "none"
# When unavailable, deterministic bilingual compliance text is used.
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TIMEOUT=25
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Comma-separated exact origins allowed to call browser/API endpoints.
# Local development: http://triproof.local
# Production: https://t.focusautomobiles.com
# "*" is supported but discouraged for production.
CORS_ALLOWED_ORIGINS=http://triproof.local

# Per-minute API rate limits (keyed by user, falling back to IP).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120
RATE_LIMIT_VERIFY=600
RATE_LIMIT_AI=20
RATE_LIMIT_EXPORT=30

# ---------------------------------------------------------------------------
# Bootstrap / demo data
# ---------------------------------------------------------------------------
ADMIN_NAME="TriProof Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
TRIPROOF_DEMO_SEED=false
TRIPROOF_DEMO_PASSWORD=
TRIPROOF_SHOW_DEMO_HINTS=false

# ---------------------------------------------------------------------------
# MCP, provenance graph, vector search, analytics, webhooks, local LLM
# ---------------------------------------------------------------------------
RATE_LIMIT_MCP=60
MCP_API_KEY=
MCP_API_KEY_USER_ID=

ALERT_WEBHOOK_SECRET=

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT=10

VECTOR_DB_URL=
VECTOR_DB_COLLECTION=triproof_contextual
VECTOR_DB_TIMEOUT=10

DUCKDB_PATH=storage/analytics/triproof.duckdb
ANALYTICS_SNAPSHOT_DIR=storage/analytics/snapshots

LOCAL_AI_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=qwen2.5:7b
LOCAL_AI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Laravel framework defaults (safe placeholders; override only when needed)
# ---------------------------------------------------------------------------
APP_MAINTENANCE_STORE=file
APP_PREVIOUS_KEYS=
AUTH_GUARD=web
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=60
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_HOST=127.0.0.1
BEANSTALKD_QUEUE_RETRY_AFTER=30
CACHE_PREFIX=triproof_cache_
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true
DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=cache_locks
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_TRACE=false
LOG_PAPERTRAIL_HANDLER=errorlog
LOG_SLACK_EMOJI=:boom:
LOG_SLACK_USERNAME=TriProof
LOG_SLACK_WEBHOOK_URL=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=LOCAL0
MAIL_EHLO_DOMAIN=localhost
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDMAIL_PATH='/usr/sbin/sendmail -bs'
MAIL_URL=
MAIL_LOG_CHANNEL=log
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
MYSQL_ATTR_SSL_CA=
PAPERTRAIL_PORT=60000
PAPERTRAIL_URL=
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
QR_PREVIEW_PAIRS=2
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_USERNAME=null
REDIS_URL=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=triproof_redis_
REDIS_CLUSTER=redis
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_CACHE_LOCK_CONNECTION=null
REDIS_PERSISTENT=false
RESEND_API_KEY=
SESSION_CONNECTION=
SESSION_STORE=database
SESSION_TABLE=sessions
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false
SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_BOT_USER_OAUTH_TOKEN=
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=
