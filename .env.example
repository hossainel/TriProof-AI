APP_NAME="TriProof AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://triproof.example.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=triproof_ai
DB_USERNAME=triproof
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@triproof.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Ed25519 master signing keys (generate with: php artisan triproof:keys --write)
# HQ_PRIVATE_SIGNING_KEY never leaves the server.
# UNIVERSAL_PUBLIC_VERIFICATION_KEY is embedded in mobile clients.
# ---------------------------------------------------------------------------
HQ_PRIVATE_SIGNING_KEY=
UNIVERSAL_PUBLIC_VERIFICATION_KEY=
KEY_ROTATION_MONTHS=6

# External Merkle anchoring and out-of-band clone/recall alerts
ANCHOR_PROVIDER=local_ledger
ALERT_WEBHOOK_URL=

# JWT API tokens (use a long random value; defaults to APP_KEY if omitted)
JWT_SECRET=
JWT_TTL_MINUTES=720
JWT_ISSUER=triproof-ai
JWT_AUDIENCE=triproof-mobile

# Offline blacklist package hard cap (bytes). Requirement: below 50 KB.
OFFLINE_BLACKLIST_MAX_BYTES=50000
OFFLINE_BLACKLIST_MAX_CLONED=5000
OFFLINE_BLOOM_TARGET_ENTRIES=30000
OFFLINE_BLOOM_MAX_BITS=240000

# Store Checkout Grace Rule
VERIFICATION_GRACE_SECONDS=300
VERIFICATION_GRACE_METERS=100

# Batch generation / PDF safety limits
MAX_BATCH_GENERATE=50000
MAX_PDF_UNITS=20000

# ---------------------------------------------------------------------------
# AI providers: "openai" for any OpenAI-compatible endpoint, "gemini", or "none"
# When unavailable, deterministic bilingual compliance text is used.
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TIMEOUT=25
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Comma-separated exact origins; "*" is supported but discouraged for production.
CORS_ALLOWED_ORIGINS=https://app.triproof.example.com

# Per-minute API rate limits (keyed by user, falling back to IP).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120
RATE_LIMIT_VERIFY=600
RATE_LIMIT_AI=20
RATE_LIMIT_EXPORT=30

# ---------------------------------------------------------------------------
# Bootstrap / demo data
# ---------------------------------------------------------------------------
ADMIN_NAME="TriProof Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
TRIPROOF_DEMO_SEED=false
TRIPROOF_DEMO_PASSWORD=
TRIPROOF_SHOW_DEMO_HINTS=false
